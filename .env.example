# ============================================================
# DocQuery Environment Configuration Template
# Copy this file to .env and configure your actual credentials
# ============================================================

# LLM API Configuration (OpenRouter or OpenAI-compatible endpoint)
API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# PostgreSQL + pgvector Database Configuration
DB_USER=postgres
DB_PWD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB=rag_db

# Redis Conversational Memory Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_SECONDS=604800

# Embedding & Retrieval Defaults
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
DEFAULT_TOP_K=3
DEFAULT_SIMILARITY_THRESHOLD=0.45
MAX_HISTORY_TURNS=10
